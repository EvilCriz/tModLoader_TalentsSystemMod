		Header: The Spirit of the Apocalypse
		Description: "{0}% chance not to consume ammunition"
	}

	ShadowDodge: {
		Header: Holy Protection
		Description: Grants the Holy Set effect once every {0} seconds.
	}

	Reincarnation: {
		Header: Reincarnation
		Description:
			'''
			The player's health drops to 1.
			The player's health is instantly restored.
			The player is afflicted with the {0} debuff for 60 seconds.
			Cannot be used while the player is under the effect of this debuff.
			Cannot be used if the player is at full health.
			'''
	}

	ManaHealing: {
		Header: Corrupted Stone
		Description:
			'''
			You expend all your mana and restore an equal amount of health.
			You are afflicted with the {0} debuff for {1} seconds.
			This ability cannot be reactivated while the debuff is active.
			Natural mana regeneration is disabled for the first {2} seconds of the debuff's duration.
			'''
	}

	HealthRegenMana: {
		Header: Hand of the Otherworldly
		Description:
			'''
			Reduces your health to 1.
			Fully restores your mana.
			Cannot be used if health is less than {0}
			'''
	}

	SpawnRate: {
		Header: Warrior's Banner
		Description: Changes the enemy spawn rate by a factor of {0}.
	}

	GrapManaStars: {
		Header: Drawing energy
		Description:
			'''
			Item ({0}) pickup range increased by {1}%
			The pull speed does NOT change (like the item: {2}).
			It stacks with other modifiers.
			'''
	}

	FullManaRestoration: {
		Header: Mana Ring
		Description:
			'''
			Fully restores mana upon activation
			Applies the {0} effect for {1} seconds
			If the player already had this debuff with a longer duration, the duration is reduced.
			Cannot be used again while the effect is active on the player
			'''
	}

	HealthCostWhenManaIsLow: {
		Header: Ring of Sacrifice
		Description:
			'''
			If you do not have enough mana, you spend health instead of mana. 
			{0} (and similar effects) trigger if you lack both health and mana.

			It is impossible to take fatal damage with this ability.
			'''
	}
}

TalentsCommon: {
	FloatDesc: (mathematical rounding)
	DamageType: (type: {0})
	IsStandingStill: The effect is active only if the character is standing still.
	OutOfCombat:
		'''
		The effect is active only if your character has been out of combat for {0} seconds
		The combat state updates when your character takes or deals damage
		'''
	LastTargetWithinRadius: The effect is active only if the last attacked target is within a radius (in tiles) of {0}
	IsMaxMana: This effect is active only when the player has full mana and for {0} seconds thereafter
	IsMaxLife: This effect is active only when the player has full health and for {0} seconds thereafter
	IsLowHealth: This effect is active only when the player health is {0}% or less
}

Buffs: {
	BuffOutOfCombat: {
		DisplayName: Out of combat
		Description:
			'''
			Time spent out of combat
			Dealing or taking damage resets the timer
			It plays an important role for certain talents
			'''
	}

	BuffSpawnRate: {
		DisplayName: Enemy spawn rate
		Description: The enemy spawn rate has been changed
	}

	BuffManaHealingCooldown: {
		DisplayName: "{$Talents.ManaHealing.Header}"
		Description: Prevents reuse of the skill: {$Talents.ManaHealing.Header}
	}
}

Changelogs: {
	Version: Version

	v_0_0_0_1: {
		Header: Mod release
		Description:
			'''
			Initial release of the mod.

			The talent tree is minimally populated—just enough to ensure full functionality; 
			it will be expanded in the future.

			Most sprites are unfinished, 
			so in-game item icons are being used as placeholders.

			The mod supports multiplayer but has undergone very limited testing.

			Please share any ideas for talents you would like to see, 
			and report any bugs you encounter.
			'''
	}
}
