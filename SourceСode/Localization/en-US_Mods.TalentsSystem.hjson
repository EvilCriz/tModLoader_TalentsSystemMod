MainMenu: {
	UI_ModDescription:
		'''
		This mod adds 6 talent branches:
		1. Warrior
		2. Ranger
		3. Mage
		4. Summoner
		5. Warlock
		6. Traveler

		Complete quests to increase your level
		For each level, you receive 1 talent point for EACH branch
		The list of quests can be found in the tab below

		When completing tasks, some of them count for all players on the server
		General quests are marked with the symbol: ⟳
		Local quests are marked with the symbol: ⟲

		Some operations are registered with a delay of a couple of seconds
		(there may be a delay of up to 15 seconds on the server)
		Some tasks have been replaced for the Calamity Mod


		Only 1 talent branch can be active at a time
		You can change the active talent branch at any time

		You can reset and redistribute your talents at any time

		A set of talent tasks for the Calamity Mod.


		The Warlock branch is a reworked version of the Mage mechanic
		You will need to keep your health low to increase your damage.


		The mod defines configuration settings.
		They allow you to customize the main menu controls.


		[BETTA]:

		The mod is under development
		The mod is adapted for multiplayer but has undergone limited multiplayer testing
		Please report any bugs you find

		Some of the sprites are not yet finished.

		The talent variations are minimally populated for the mod's initial release. 
		They will be expanded upon in the future.
		'''

	Header: {
		UI_Header_Changelog: Changelog
		UI_Header_Theme: Themes
		UI_Header_Info: Information
		UI_Header_Quests: Quests
		UI_Header_Melee: Warrior
		UI_Header_Range: Ranger
		UI_Header_Magic: Mage
		UI_Header_Warlock: Warlock
		UI_Header_Summon: Summoner
		UI_Header_Travel: Traveler
		UI_Header_Current: current
	}

	Themes: {
		UI_Theme_Terraria: Terraria Theme
		UI_Theme_Dark: Dark Theme
		UI_Theme_Blue: Blue Theme
		UI_Theme_Brown: Brown Theme
		UI_Theme_Phantom: Phantom Theme
	}

	PointsInfo: {
		UI_Available_Points: Available talents points: {0}
		UI_Spent_Points: Spent talents points: {0}
		UI_Button_ActivateBranch: Mods.TalentsSystem.MainMenu.PointsInfo.UI_Button_ActivateBranch
	}

	Buttons: {
		UI_Button_ActivateBranch: Activate
		UI_Button_ResetPointsBranch: Reset
		UI_Button_Ok: Confirm
		UI_Button_Cancel: Cancel
		UI_Button_CompletedQuest: Completed Quests
		UI_Button_IncompletedQuest: Incompleted Quests
		UI_Button_AllQuest: All Quests
	}

	LevelInfo: {
		UI_LevelInfo_Level: Level: {0} / {1}
		UI_LevelInfo_Exp: Exp: {0} / {1}
		UI_LevelInfo_Quests: Quests: {0} / {1}
	}

	Confirmation: {
		UI_Confirm_Header: Confirmation
		UI_Confirm_SwitchBranch: Are you sure you want to switch to this talent tree?
		UI_Confirm_ResetPoints: Are you sure you want to reset all talent points for this tree?
		UI_Confirm_SpendPoint: Are you sure you want to spend a talent point to upgrade the {0} skill to level {1}?
	}

	Quests.UI_Quests_Exp: Exp: {0}

	Talents: {
		UI_Talents_ActivateType: Activation type:
		UI_Talents_ActivationType_Passive: "{$MainMenu.Talents.UI_Talents_ActivateType} Passive"
		UI_Talents_ActivationType_Active: "{$MainMenu.Talents.UI_Talents_ActivateType} Active"
		UI_Talents_ActivationType_Switchable: "{$MainMenu.Talents.UI_Talents_ActivateType} Switchable"
		UI_Talents_CurrentLevel: Current level:
		UI_Talents_NextLevel: Next level:
	}
}

